# Copy this file to .env before running Docker Compose.
# Never commit real secrets.

# PostgreSQL
POSTGRES_DB=dibobo
POSTGRES_USER=dibobo
POSTGRES_PASSWORD=replace-with-a-long-random-password
DIBOBO_DATABASE_URL=postgresql+asyncpg://dibobo:replace-with-a-long-random-password@postgres:5432/dibobo

# Valkey
DIBOBO_VALKEY_URL=redis://valkey:6379/0

# Application
DIBOBO_APP_ENV=production
DIBOBO_APP_PUBLIC_URL=http://localhost:8080
DIBOBO_TIMEZONE=Asia/Shanghai
DIBOBO_LOG_LEVEL=INFO
DIBOBO_QUOTE_REFRESH_SECONDS=5
DIBOBO_VALUATION_CACHE_MINUTES=5
DIBOBO_UPSTREAM_TIMEOUT_SECONDS=8
DIBOBO_UPSTREAM_CONCURRENCY=4
DIBOBO_LOGIN_FAILURE_LIMIT=5
DIBOBO_LOGIN_LOCK_SECONDS=300

# Generate independent random values. Do not reuse these examples.
# SESSION_SECRET: at least 32 random characters.
DIBOBO_SESSION_SECRET=replace-with-at-least-32-random-characters
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DIBOBO_API_KEY_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
DIBOBO_SESSION_SECURE_COOKIE=false

# Optional first-start user. Remove the password after the first successful start.
DIBOBO_INITIAL_USERNAME=
DIBOBO_INITIAL_PASSWORD=
